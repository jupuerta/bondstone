{
  "name": "exposed-database solution",
  "nodes": [
    { "name": "Edge", "type": "Gateway", "x": -280, "y": 60, "configuration": { "requestsPerSecond": 100, "authentication": true, "rateLimit": 200 } },
    { "name": "Front", "type": "LoadBalancer", "x": 0, "y": 60, "configuration": { "healthCheck": true } },
    { "name": "Reports", "type": "LoadBalancer", "x": 0, "y": 340, "configuration": { "requestsPerSecond": 20, "healthCheck": true } },
    { "name": "Storefront", "type": "Api", "x": 280, "y": 0, "configuration": { "authentication": true } },
    { "name": "Storefront 2", "type": "Api", "x": 280, "y": 240, "configuration": { "authentication": true } },
    { "name": "Db", "type": "Database", "x": 560, "y": 120 },
    { "name": "Telemetry", "type": "Observability", "x": 280, "y": 480 }
  ],
  "connections": [
    { "from": "Edge", "to": "Front", "synchronous": true, "configuration": { "timeoutSeconds": 5 } },
    { "from": "Front", "to": "Storefront", "synchronous": true, "configuration": { "timeoutSeconds": 5 } },
    { "from": "Front", "to": "Storefront 2", "synchronous": true, "configuration": { "timeoutSeconds": 5 } },
    { "from": "Reports", "to": "Storefront", "synchronous": true, "configuration": { "timeoutSeconds": 5 } },
    { "from": "Reports", "to": "Storefront 2", "synchronous": true, "configuration": { "timeoutSeconds": 5 } },
    { "from": "Storefront", "to": "Db", "synchronous": true, "configuration": { "timeoutSeconds": 5 } },
    { "from": "Storefront 2", "to": "Db", "synchronous": true, "configuration": { "timeoutSeconds": 5 } },
    { "from": "Edge", "to": "Telemetry", "synchronous": false, "configuration": {} },
    { "from": "Front", "to": "Telemetry", "synchronous": false, "configuration": {} },
    { "from": "Reports", "to": "Telemetry", "synchronous": false, "configuration": {} },
    { "from": "Storefront", "to": "Telemetry", "synchronous": false, "configuration": {} },
    { "from": "Storefront 2", "to": "Telemetry", "synchronous": false, "configuration": {} },
    { "from": "Db", "to": "Telemetry", "synchronous": false, "configuration": {} }
  ]
}
