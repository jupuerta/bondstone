{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // No connection string here on purpose: a default that carries a password is a credential
  // shipped in the repo, and one that works is worse than none. It arrives from the environment
  // (`ConnectionStrings__Bondstone`), and AddInfrastructure refuses to start without it.
  "ConnectionStrings": {},
  "Cors": {
    "AllowedOrigins": []
  },
  // ForwardLimit is how many proxies stand in front, i.e. how far back from the right of
  // `X-Forwarded-For` the real client is. 1 is the framework's default and the local stack's truth
  // (nginx only); production adds Caddy and sets `ForwardedHeaders__ForwardLimit=2`. Get it wrong
  // upwards and a client can spoof its address; wrong downwards and everyone shares the proxy's
  // rate-limit bucket.
  "ForwardedHeaders": {
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  // true only where a proxy in front actually terminates TLS: it turns on HSTS and redirects
  // anything that arrived over plain HTTP. With no certificate in front it redirects into a
  // closed port, which is the honest failure rather than quiet plaintext.
  "Security": {
    "RequireHttps": false,
    "HttpsPort": 443
  },
  // One container against one database can migrate on the way up. More than one replica races,
  // and doing it here forces the runtime role to own the schema — turn this off and migrate as
  // its own deployment step when either of those becomes true.
  "Database": {
    "MigrateOnStartup": true
  },
  // The ceiling on everybody's rows put together. The rate limiter asks whether *this* caller has
  // had enough, which is a question anybody with a second address walks around; this one asks
  // whether there is any room left at all, which nobody can.
  //
  // Above it the four endpoints that create an architecture answer 503, and everything else —
  // reading, editing, analysing and, above all, deleting — keeps working. That turns "the disk
  // filled and took everyone's work with it" into "no new architectures for now".
  //
  // 0 turns it off, which is what local work and the tests want.
  "Storage": {
    "MaxDatabaseBytes": 2147483648,
    "MeasureEverySeconds": 30
  }
}
