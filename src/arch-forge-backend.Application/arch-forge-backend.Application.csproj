<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\arch-forge-backend.Domain\arch-forge-backend.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="FluentValidation" Version="11.11.0" />
  </ItemGroup>


  <ItemGroup>
    <!-- V4 D1.5: challenge definitions and their blueprints travel inside the assembly. A file
         that is missing at runtime is not a state ChallengeCatalog should be able to reach. -->
    <EmbeddedResource Include="Challenges\Definitions\*.json" />

    <!-- V7 D1.2: the text catalogue travels inside the assembly for the same reason as the
         challenge definitions. The exporter is the one surface that still renders prose on the
         server, and a locale file missing at runtime is not a state it should be able to reach. -->
    <EmbeddedResource Include="Localization\Resources\*.json" />

    <!-- V5 D2.5: the prompt is versioned content, not a constant in code - same criterion as the
         challenge definitions. It travels inside the assembly for the same reason: a file that is
         missing at runtime is not a state the exporter should be able to reach. -->
    <EmbeddedResource Include="Export\Prompt.md" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>arch_forge_backend.Application</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
