{
  "name": "no-new-hardware solution",
  "nodes": [
    { "name": "Storefront", "type": "Api", "x": 0, "y": 160, "configuration": { "requestsPerSecond": 350, "authentication": true } },
    { "name": "Edge cache", "type": "Cache", "x": 300, "y": 160, "configuration": { "hitRatio": 0.8 } },
    { "name": "Db", "type": "Database", "x": 600, "y": 160 }
  ],
  "connections": [
    { "from": "Storefront", "to": "Edge cache", "protocol": "Http", "synchronous": true, "configuration": { "timeoutSeconds": 5, "fallback": true } },
    { "from": "Edge cache", "to": "Db", "protocol": "Sql", "synchronous": true, "configuration": { "timeoutSeconds": 5 } }
  ]
}
