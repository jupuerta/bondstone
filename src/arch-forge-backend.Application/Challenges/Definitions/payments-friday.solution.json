{
  "name": "payments-friday solution",
  "nodes": [
    { "name": "Storefront", "type": "Api", "x": 0, "y": 160 },
    { "name": "Orders", "type": "Service", "x": 260, "y": 160 },
    { "name": "Payments", "type": "Service", "x": 520, "y": 60 },
    { "name": "Db", "type": "Database", "x": 520, "y": 280 }
  ],
  "connections": [
    {
      "from": "Storefront",
      "to": "Orders",
      "protocol": "Http",
      "synchronous": true,
      "configuration": { "timeoutSeconds": 3, "fallback": true }
    },
    {
      "from": "Orders",
      "to": "Payments",
      "protocol": "Http",
      "synchronous": true,
      "configuration": { "timeoutSeconds": 2, "circuitBreaker": true, "fallback": true }
    },
    {
      "from": "Orders",
      "to": "Db",
      "protocol": "Sql",
      "synchronous": true,
      "configuration": { "timeoutSeconds": 5, "circuitBreaker": true, "fallback": true }
    }
  ]
}
