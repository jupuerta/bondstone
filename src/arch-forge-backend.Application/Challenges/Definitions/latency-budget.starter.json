{
  "name": "latency-budget starter",
  "nodes": [
    { "name": "Storefront", "type": "Api", "x": 0, "y": 120, "configuration": { "requestsPerSecond": 300 } },
    { "name": "Catalog", "type": "Service", "x": 220, "y": 120 },
    { "name": "Db", "type": "Database", "x": 440, "y": 120 }
  ],
  "connections": [
    {
      "from": "Storefront",
      "to": "Catalog",
      "protocol": "Http",
      "synchronous": true,
      "configuration": { "timeoutSeconds": 5 }
    },
    {
      "from": "Catalog",
      "to": "Db",
      "protocol": "Sql",
      "synchronous": true,
      "configuration": { "timeoutSeconds": 5 }
    }
  ]
}
