{
  "name": "backlog solution",
  "nodes": [
    {
      "name": "Storefront",
      "type": "Api",
      "x": 0,
      "y": 200,
      "configuration": {
        "requestsPerSecond": 500,
        "instances": 2,
        "authentication": true
      }
    },
    {
      "name": "Jobs",
      "type": "Queue",
      "x": 260,
      "y": 200,
      "configuration": {
        "deadLetterQueue": true,
        "maxRetries": 3
      }
    },
    {
      "name": "Worker",
      "type": "Worker",
      "x": 520,
      "y": 40,
      "configuration": {
        "instances": 2
      }
    },
    {
      "name": "Worker 2",
      "type": "Worker",
      "x": 520,
      "y": 200,
      "configuration": {
        "instances": 2
      }
    },
    {
      "name": "Worker 3",
      "type": "Worker",
      "x": 520,
      "y": 360,
      "configuration": {
        "instances": 2
      }
    },
    {
      "name": "Db",
      "type": "Database",
      "x": 800,
      "y": 200,
      "configuration": {
        "readReplicas": 3
      }
    }
  ],
  "connections": [
    {
      "from": "Storefront",
      "to": "Jobs",
      "protocol": "Amqp",
      "synchronous": false,
      "configuration": {}
    },
    {
      "from": "Jobs",
      "to": "Worker",
      "protocol": "Amqp",
      "synchronous": false,
      "configuration": {}
    },
    {
      "from": "Jobs",
      "to": "Worker 2",
      "protocol": "Amqp",
      "synchronous": false,
      "configuration": {}
    },
    {
      "from": "Jobs",
      "to": "Worker 3",
      "protocol": "Amqp",
      "synchronous": false,
      "configuration": {}
    },
    {
      "from": "Worker",
      "to": "Db",
      "protocol": "Sql",
      "synchronous": true,
      "configuration": {
        "timeoutSeconds": 5,
        "circuitBreaker": true,
        "fallback": true
      }
    },
    {
      "from": "Worker 2",
      "to": "Db",
      "protocol": "Sql",
      "synchronous": true,
      "configuration": {
        "timeoutSeconds": 5,
        "circuitBreaker": true,
        "fallback": true
      }
    },
    {
      "from": "Worker 3",
      "to": "Db",
      "protocol": "Sql",
      "synchronous": true,
      "configuration": {
        "timeoutSeconds": 5,
        "circuitBreaker": true,
        "fallback": true
      }
    }
  ]
}
