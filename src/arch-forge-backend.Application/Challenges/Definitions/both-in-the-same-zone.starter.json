{
  "name": "both-in-the-same-zone starter",
  "nodes": [
    { "name": "Edge", "type": "Gateway", "x": -520, "y": 160, "configuration": { "requestsPerSecond": 300, "authentication": true, "rateLimit": 600, "zone": "a" } },
    { "name": "Front", "type": "LoadBalancer", "x": -260, "y": 160, "configuration": { "healthCheck": true, "zone": "a" } },
    { "name": "Api", "type": "Api", "x": 40, "y": 40, "configuration": { "zone": "a" } },
    { "name": "Api 2", "type": "Api", "x": 40, "y": 280, "configuration": { "zone": "a" } },
    { "name": "Cache", "type": "Cache", "x": 340, "y": 160, "configuration": { "hitRatio": 0.8, "zone": "a" } },
    { "name": "Db", "type": "Database", "x": 600, "y": 160, "configuration": { "zone": "a" } },
    { "name": "Telemetry", "type": "Observability", "x": 170, "y": 480, "configuration": { "zone": "a" } }
  ],
  "connections": [
    { "from": "Edge", "to": "Front", "protocol": "Http", "synchronous": true, "configuration": { "timeoutSeconds": 5 } },
    { "from": "Front", "to": "Api", "protocol": "Http", "synchronous": true, "configuration": { "timeoutSeconds": 5 } },
    { "from": "Front", "to": "Api 2", "protocol": "Http", "synchronous": true, "configuration": { "timeoutSeconds": 5 } },
    { "from": "Api", "to": "Cache", "protocol": "Http", "synchronous": true, "configuration": { "timeoutSeconds": 2, "fallback": true } },
    { "from": "Api 2", "to": "Cache", "protocol": "Http", "synchronous": true, "configuration": { "timeoutSeconds": 2, "fallback": true } },
    { "from": "Cache", "to": "Db", "protocol": "Sql", "synchronous": true, "configuration": { "timeoutSeconds": 5, "fallback": true } },
    { "from": "Edge", "to": "Telemetry", "protocol": "Http", "synchronous": false, "configuration": {} },
    { "from": "Front", "to": "Telemetry", "protocol": "Http", "synchronous": false, "configuration": {} },
    { "from": "Api", "to": "Telemetry", "protocol": "Http", "synchronous": false, "configuration": {} },
    { "from": "Api 2", "to": "Telemetry", "protocol": "Http", "synchronous": false, "configuration": {} },
    { "from": "Cache", "to": "Telemetry", "protocol": "Http", "synchronous": false, "configuration": {} },
    { "from": "Db", "to": "Telemetry", "protocol": "Http", "synchronous": false, "configuration": {} }
  ]
}
