{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // No connection string here on purpose: a default that carries a password is a credential
  // shipped in the repo, and one that works is worse than none. It arrives from the environment
  // (`ConnectionStrings__Bondstone`), and AddInfrastructure refuses to start without it.
  "ConnectionStrings": {},
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  // true only where a proxy in front actually terminates TLS: it turns on HSTS and redirects
  // anything that arrived over plain HTTP. With no certificate in front it redirects into a
  // closed port, which is the honest failure rather than quiet plaintext.
  "Security": {
    "RequireHttps": false,
    "HttpsPort": 443
  },
  // One container against one database can migrate on the way up. More than one replica races,
  // and doing it here forces the runtime role to own the schema — turn this off and migrate as
  // its own deployment step when either of those becomes true.
  "Database": {
    "MigrateOnStartup": true
  }
}
