{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Only for `dotnet run` outside Docker: the compose stack passes this origin by environment
  // (`Cors__AllowedOrigins__0`) and never reads this file. 5174 is the frontend's dev server
  // (`arch-forge-frontend-next/vite.config.ts`) — keep the two in step or `npm run dev` loses CORS.
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5174" ]
  }
}
