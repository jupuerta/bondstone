# Copy to .env before `docker compose up`, then fill POSTGRES_PASSWORD in — compose refuses to
# start while it is empty, on purpose. There is no default any more: the old one (`bondstone`)
# worked, and a fallback that works is the one nobody ever replaces.
#
#   cp .env.example .env
#   python3 -c "import secrets,string;print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(32)))"
#
# Letters and digits only: the value is pasted into a Npgsql connection string, where `;` and `'`
# would end the field early, and read by compose, where `$` starts a substitution.

POSTGRES_DB=bondstone
POSTGRES_USER=bondstone
POSTGRES_PASSWORD=

# Host port the frontend is published on (la web y el editor: un solo servicio desde el 07-09-2026).
FRONTEND_PORT=8080

# Where the browser sends API calls. Keep the default: the frontend's nginx proxies
# /api to the api service, so requests stay same-origin and CORS never comes up.
VITE_API_URL=/api

# La demostración de la portada: dos arquitecturas de solo lectura («la tienda» rota y arreglada),
# creadas con arch-forge-frontend-next/scripts/create-demo.mjs contra esta misma base de datos.
# Vacías: la portada enseña el panel «sin configurar» en su lugar.
VITE_DEMO_BEFORE_TOKEN=
VITE_DEMO_AFTER_TOKEN=
# Componente que se tumba en la demostración (se busca por nombre en la arquitectura).
VITE_DEMO_FAULT_NODE=Postgres

