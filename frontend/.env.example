# URL base de la API de Bondstone.
#
# Deja la ruta relativa: el dev server debe proxyar /api a http://localhost:5012 (la API que
# publica docker-compose.override.yml) y nginx la proxya dentro de la imagen. En los dos casos
# las peticiones son del mismo origen y CORS no aparece.
VITE_API_URL=/api

# ¿API en otro sitio? Una URL absoluta también funciona, pero ese origen tiene que estar en
# Cors:AllowedOrigins del backend.
# VITE_API_URL=http://localhost:8080/api

# La demostración de la portada: «la tienda» con la base de datos caída. Son dos arquitecturas
# guardadas en la base de datos de la API (la rota y la arreglada), identificadas por su enlace
# de solo lectura. Se crean con scripts/create-demo.mjs contra la API que vayas a usar; los
# tokens son de esa base de datos y no valen en otra.
VITE_DEMO_BEFORE_TOKEN=
VITE_DEMO_AFTER_TOKEN=
# El nombre del componente que se tumba (se busca por nombre en la arquitectura).
VITE_DEMO_FAULT_NODE=Postgres
