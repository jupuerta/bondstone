{
  "name": "arch-forge-frontend-next",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:i18n && npm run check:csp && tsc -b && vite build",
    "preview": "vite preview --port 5174",
    "typecheck": "tsc -b --noEmit",
    "check:i18n": "node scripts/check-catalogs.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "check:a11y": "node scripts/a11y/run.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "acceptance:slice-2-3": "node scripts/acceptance/slice-2-3.mjs",
    "acceptance:theme-panel-web": "node scripts/acceptance/theme-panel-web.mjs",
    "regenerate:goldens": "vite-node scripts/regenerate-export-goldens.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@xyflow/react": "12.11.2",
    "opentype.js": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.13.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
